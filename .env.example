# Локально можно оставить LOCALY_REPO=json. На Railway/Vercel требуется supabase.
LOCALY_REPO=json

# Обязательные production-секреты (минимум 32 случайных символа).
LOCALY_SESSION_SECRET=
LOCALY_OTP_SECRET=
# Ровно 32 случайных байта в base64, например: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Production Supabase (service-role используется только на сервере).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# SMS webhook получает JSON: { phone, code, message }.
LOCALY_SMS_WEBHOOK_URL=
LOCALY_SMS_WEBHOOK_SECRET=

# Задайте отдельный пароль начальных demo-аккаунтов при production seed.
LOCALY_DEMO_PASSWORD=
